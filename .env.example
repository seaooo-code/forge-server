APP_ENV=local
APP_SHUTDOWN_TIMEOUT=10s
# ENV_FILE=.env

HTTP_ADDR=:8080
HTTP_CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
HTTP_CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization,Traceparent,Tracestate,Baggage,X-Request-Id
HTTP_CORS_ALLOW_CREDENTIALS=true

OTEL_ENABLED=false
OTEL_SERVICE_NAME=forge-server
OTEL_SERVICE_VERSION=0.1.0
OTEL_DEPLOYMENT_ENVIRONMENT=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://jovial_snyder.orb.local:4318
# ClickStack Open Source:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://<clickstack-otel-collector>:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=<your-clickstack-ingestion-key>
# Optional signal-specific overrides:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://<clickstack-otel-collector>:4318/v1/traces
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://<clickstack-otel-collector>:4318/v1/logs
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=authorization=<your-clickstack-ingestion-key>
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=authorization=<your-clickstack-ingestion-key>

POSTGRES_DSN=postgres://postgres:postgres@127.0.0.1:5432/forge_server?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=1
POSTGRES_MAX_CONN_LIFETIME=30m
POSTGRES_MAX_CONN_IDLE_TIME=15m

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://127.0.0.1:5173/login/feishu/callback
# 空格分隔，列出的权限都需要先在飞书应用后台开通：
# - offline_access：必需，否则不返回 refresh token，登录态约 2 小时失效
# - contact:user:search：负责人搜索
# - contact:contact.base:readonly + contact:user.email:readonly：搜索结果补全邮箱，可选，缺失时结果不带邮箱
FEISHU_OAUTH_SCOPE=offline_access contact:user:search contact:contact.base:readonly contact:user.email:readonly
FEISHU_OAUTH_PROMPT=
FEISHU_DEBUG_LOG_SEARCH_RESPONSE=false

GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_WEB_URL=https://github.com
GITHUB_APP_NAME=Forge Console
GITHUB_APP_HOMEPAGE_URL=http://127.0.0.1:5173
GITHUB_APP_MANIFEST_CALLBACK_URL=http://127.0.0.1:8080/api/v1/code-sources/github/manifest/callback
GITHUB_APP_INSTALL_CALLBACK_URL=http://127.0.0.1:8080/api/v1/code-sources/github/install/callback
GITHUB_APP_INSTALL_REDIRECT_URL=http://127.0.0.1:5173/code-sources
# 可选：兼容手动创建的 GitHub App；默认通过页面自动创建并写入数据库。
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY=
# 可选：手动创建的 GitHub App 的 webhook secret；页面自动创建的 App 会把 secret 写入数据库。
# GITHUB_APP_WEBHOOK_SECRET=
# 可选：GitHub App 接收 push 事件的公网地址，例如 https://forge.example.com/api/v1/webhooks/github。
# GitHub 不接受 localhost，留空时创建 App 不会配置 webhook。
# GITHUB_APP_WEBHOOK_URL=

# 必填：加密代码源凭证、webhook secret、密钥类构建变量的 AES-256 主密钥（32 字节 base64）。
# 生成方式：openssl rand -base64 32。部署后不要更换，否则已加密的数据无法解密。
FORGE_SECRET_KEY=

FORGE_WORKER_ID=
FORGE_WORKER_WORK_DIR=/tmp/forge-worker
FORGE_WORKER_POLL_INTERVAL=5s
FORGE_WORKER_LEASE_DURATION=30m
FORGE_WORKER_BUILD_TIMEOUT=30m
FORGE_WORKER_DOCKERFILE=Dockerfile
FORGE_WORKER_ARTIFACT_PREFIX=rn-bundles
# 单次构建日志上限（字节），默认 5242880（5 MiB）。超出后只保留开头和最后一段，尾部在构建结束时写入。
FORGE_WORKER_LOG_MAX_BYTES=5242880
# 构建日志保留期，由 API 进程后台清理。支持 30d 这样的天数写法或 Go duration（如 720h），默认 30d。
FORGE_BUILD_LOG_RETENTION=30d
# 清单文件项 digests 要计算的摘要算法，逗号分隔，可选 sha256、md5，默认 sha256。sha256 字段始终会计算。
FORGE_ARTIFACT_DIGESTS=sha256
